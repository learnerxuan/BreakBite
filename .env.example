# Working local-account product. All accounts, sessions and orders persist in JSON.
AUTH_MODE=local
STORE=file
HOST=127.0.0.1
PORT=8080
DATA_DIR=.data
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
COOKIE_SECURE=false

# Experimental APSpace timetable source. Enable for a qualified local pilot.
BREAKBITE_APSPACE=false

# For a PRIVATE, trusted Wi-Fi test only (do not use real passwords/student data):
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://192.168.1.10:8080,http://127.0.0.1:8080
# ALLOW_INSECURE_LAN=true
# Replace the IP with the server computer's actual LAN IP. Never port-forward it.

# Internet access requires an HTTPS reverse proxy, COOKIE_SECURE=true and exact
# HTTPS ALLOWED_ORIGINS, plus a separate security/deployment review.
# Gemini Enterprise integration is deferred.
# Do not add credentials to this file or commit any .env / .data files.

# Firestore storage (optional). Same app and accounts; the data in database.json is kept
# in Cloud Firestore instead. Setup and tests: docs/FIRESTORE.md.
# DATA_DIR above is still used for uploaded photos and web-push-keys.json.
# STORE=firestore
# GOOGLE_CLOUD_PROJECT=your-project-id
# Your database ID from Firestore in the console, or (default):
# FIRESTORE_DATABASE=your-database-id
# Shared data lives under envs/production; use envs/dev-yourname for personal testing.
# FIRESTORE_ROOT=envs/production
# Service-account key stored OUTSIDE the repo (~ means your home folder). Never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=~/secrets/your-key-file.json
# For hosting without files, put the key JSON (or its base64) in FIREBASE_SERVICE_ACCOUNT_JSON instead.
# How often requests check for writes by another process (operator CLI, second server). 0 = off.
# FIRESTORE_REFRESH_MS=5000

# Background Web Push (no Google/Firebase project needed):
# npm run build
# npm run push:keys -- --subject=mailto:YOUR_CONTACT_EMAIL
# Then set true and restart. Keep DATA_DIR/web-push-keys.json private and backed up.
PUSH_ENABLED=false
# Phones require HTTPS and permission; plain HTTP LAN mode cannot enable push.

# Working local-account product. All accounts, sessions and orders persist in JSON.
AUTH_MODE=local
STORE=file
HOST=127.0.0.1
PORT=8080
DATA_DIR=.data
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
COOKIE_SECURE=false

# For a PRIVATE, trusted Wi-Fi test only (do not use real passwords/student data):
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://192.168.1.10:8080,http://127.0.0.1:8080
# ALLOW_INSECURE_LAN=true
# Replace the IP with the server computer's actual LAN IP. Never port-forward it.

# Internet access requires an HTTPS reverse proxy, COOKIE_SECURE=true and exact
# HTTPS ALLOWED_ORIGINS, plus a separate security/deployment review.
# Google/Firebase and Gemini Enterprise integration are deferred in v0.2.
# Do not add credentials to this file or commit any .env / .data files.

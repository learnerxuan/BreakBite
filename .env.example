# Local-only, no-license mode. Never expose this through a tunnel.
AUTH_MODE=demo
HOST=127.0.0.1
PORT=8080
STORE=file
DATA_DIR=.data
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Optional random local test credential (24+ characters); leave blank to disable MCP.
DEMO_MCP_TOKEN=

# For Google deployment use infra/*.example.yaml and docs/MANUAL_SETUP.md.
# Never commit real tokens, passwords or service-account private keys.

{
  "name": "breakbite",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Campus order-ahead with QR pickup, dietary information, saved meals and timetable planning",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "test:firestore-live": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist-tests/tests/firestore-live.test.js",
    "test:firestore-memory": "tsc -p tsconfig.test.json && node scripts/test-store.mjs firestore-memory",
    "test:firestore-suite": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env scripts/test-store.mjs firestore",
    "seed:cloud": "node --env-file-if-exists=.env dist/server/seed-cloud.js",
    "operator": "node --env-file-if-exists=.env dist/server/operator-cli.js",
    "push:keys": "node --env-file-if-exists=.env scripts/push-keys.mjs"
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@vercel/blob": "2.4.0",
    "firebase-admin": "14.5.0"
  }
}
